ALETHEIA_ENV=development
ALETHEIA_DEBUG=true
ALETHEIA_HOST=127.0.0.1
ALETHEIA_PORT=8899
ALETHEIA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost
ALETHEIA_SQLITE_PATH=./data/aletheia.sqlite3
ALETHEIA_DUCKDB_PATH=./data/aletheia.duckdb
ALETHEIA_DATA_DIR=./data
ALETHEIA_REPORTS_DIR=./data/reports
ALETHEIA_EXPORTS_DIR=./data/exports
ALETHEIA_OLLAMA_BASE_URL=http://127.0.0.1:11434
ALETHEIA_DEFAULT_LLM_PROVIDER=ollama
ALETHEIA_DEFAULT_LLM_MODEL=mistral:7b
ALETHEIA_ENABLE_CLOUD_LLM_FALLBACK=false
ALETHEIA_ENABLE_AUDIT_LOGS=true
ALETHEIA_ENABLE_DESKTOP_BRIDGE=true
ALETHEIA_YFINANCE_ENABLED=true
ALETHEIA_CCXT_ENABLED=true
ALETHEIA_NSE_ENABLED=true
ALETHEIA_RBI_ENABLED=true

