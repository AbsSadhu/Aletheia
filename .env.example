ALETHEIA_ENV=development
ALETHEIA_DEBUG=true
ALETHEIA_HOST=127.0.0.1
ALETHEIA_PORT=8899
ALETHEIA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost
ALETHEIA_SQLITE_PATH=./data/aletheia.sqlite3
ALETHEIA_DUCKDB_PATH=./data/aletheia.duckdb
ALETHEIA_DATA_DIR=./data
ALETHEIA_REPORTS_DIR=./data/reports
ALETHEIA_EXPORTS_DIR=./data/exports
ALETHEIA_OLLAMA_BASE_URL=http://127.0.0.1:11434
ALETHEIA_DEFAULT_LLM_PROVIDER=ollama
ALETHEIA_DEFAULT_LLM_MODEL=mistral:7b
ALETHEIA_ENABLE_CLOUD_LLM_FALLBACK=false
ALETHEIA_ENABLE_AUDIT_LOGS=true
ALETHEIA_ENABLE_DESKTOP_BRIDGE=true
ALETHEIA_YFINANCE_ENABLED=true
ALETHEIA_CCXT_ENABLED=true
ALETHEIA_NSE_ENABLED=true
ALETHEIA_RBI_ENABLED=true
ALETHEIA_RETENTION_DAYS=30
ALETHEIA_DB_ENCRYPTION_KEY=

# Required only if you run the optional Grafana service in docker-compose.yml
# (docker-compose refuses to start it without this set — no default shipped).
GRAFANA_ADMIN_PASSWORD=

# Docker Compose only: host port for the bundled Ollama container (loopback-only).
# Default 11435 avoids clashing with an Ollama already running on the host.
OLLAMA_HOST_PORT=11435

# Per-agent-node time limit in seconds. Raise it for larger local models on slow hardware.
ALETHEIA_NODE_TIMEOUT_SECS=120

# Live NSE/BSE quotes from Angel One SmartAPI (credentials are saved in Settings, not here).
ALETHEIA_ANGEL_ONE_ENABLED=false
# Hardcoded demo prices for offline development only; never enable for real analysis.
ALETHEIA_STATIC_SEED_ENABLED=false

# Real-money orders. Leave off unless you have read README "Live data & broker orders".
ALETHEIA_LIVE_TRADING_ENABLED=false
ALETHEIA_LIVE_MAX_ORDER_VALUE=25000
ALETHEIA_LIVE_MAX_ORDER_QTY=500
ALETHEIA_LIVE_MAX_ORDERS_PER_DAY=10

# Seconds between scoring past Oracle predictions against realised prices (0 disables).
ALETHEIA_CALIBRATION_RESOLVE_INTERVAL_SECS=21600

# Live feed: max rate each symbol is pushed to the UI (seconds, min 0.2).
ALETHEIA_MARKET_FEED_EMIT_INTERVAL_SECS=1.0

# Which source feeds the stock stream: angel_one (default), fyers, or bse_web (free, unofficial, ~2s polling).
ALETHEIA_LIVE_FEED_PROVIDER=angel_one

# Free per-second crypto from Binance's public stream (only connects if the watchlist has a crypto pair).
ALETHEIA_CRYPTO_STREAM_ENABLED=true
